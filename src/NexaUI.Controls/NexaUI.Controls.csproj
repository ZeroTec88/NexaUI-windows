<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NexaUI.Controls</RootNamespace>
    <AssemblyName>NexaUI.Controls</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageId>NexaUI-windows</PackageId>
    <Version>1.0.1</Version>
    <Authors>ZeroTech</Authors>
    <Company>ZeroTech</Company>
    <Description>A modern Windows Forms UI component library for .NET 10 with theme-aware controls, designer support, and full native behavior preservation.</Description>
    <Copyright>Copyright © ZeroTech</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ZeroTec88/NexaUI-windows</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ZeroTec88/NexaUI-windows</RepositoryUrl>
    <PackageTags>winforms;dotnet;windows-forms;ui;controls;theme;designer;csharp;vbnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeContentInPack>true</IncludeContentInPack>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NEXAUI_RULES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexaUI.Core\NexaUI.Core.csproj" />
    <ProjectReference Include="..\NexaUI.Themes\NexaUI.Themes.csproj" />
    <ProjectReference Include="..\NexaUI.Icons\NexaUI.Icons.csproj" />
  </ItemGroup>

</Project>